#!/bin/sh
# ----------------------------------------------------------------------------
# Apache Maven Wrapper Executable
# ----------------------------------------------------------------------------

if [ -z "$MAVEN_SKIP_RC" ]; then
  if [ -f /etc/mavenrc ]; then
    . /etc/mavenrc
  fi
  if [ -f "$HOME/.mavenrc" ]; then
    . "$HOME/.mavenrc"
  fi
fi

# OS specific support
cygwin=false;
darwin=false;
mingw=false
case "`uname`" in
  CYGWIN*) cygwin=true ;;
  Darwin*) darwin=true ;;
  MINGW*) mingw=true ;;
esac

## Resolve links - $0 may be a link to the script
PRG="$0"
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG="`dirname "$PRG"`/$link"
  fi
done

saveddir=`pwd`
BASE_DIR=`dirname "$PRG"`
BASE_DIR=`cd "$BASE_DIR" && pwd`
cd "$saveddir"

# Auto-detect JAVA_HOME pointing to a full JDK (with javac)
if [ -z "$JAVA_HOME" ] || [ ! -x "$JAVA_HOME/bin/javac" ]; then
  if command -v javac >/dev/null 2>&1; then
    JAVAC_PATH=`command -v javac`
    while [ -h "$JAVAC_PATH" ]; do
      JAVAC_DIR=`dirname "$JAVAC_PATH"`
      JAVAC_PATH=`readlink "$JAVAC_PATH"`
      case "$JAVAC_PATH" in
        /*) ;;
        *) JAVAC_PATH="$JAVAC_DIR/$JAVAC_PATH" ;;
      esac
    done
    JAVA_HOME=`dirname "$JAVAC_PATH"`/..
    JAVA_HOME=`cd "$JAVA_HOME" && pwd`
    export JAVA_HOME
    export PATH="$JAVA_HOME/bin:$PATH"
  elif command -v java >/dev/null 2>&1; then
    JAVA_PATH=`command -v java`
    while [ -h "$JAVA_PATH" ]; do
      JAVA_DIR=`dirname "$JAVA_PATH"`
      JAVA_PATH=`readlink "$JAVA_PATH"`
      case "$JAVA_PATH" in
        /*) ;;
        *) JAVA_PATH="$JAVA_DIR/$JAVA_PATH" ;;
      esac
    done
    JAVA_HOME=`dirname "$JAVA_PATH"`/..
    JAVA_HOME=`cd "$JAVA_HOME" && pwd`
    export JAVA_HOME
    export PATH="$JAVA_HOME/bin:$PATH"
  fi
fi

# Si mvn ya está instalado en el sistema, usarlo con el JDK detectado
if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
    JAVACMD="$JAVA_HOME/jre/sh/java"
  else
    JAVACMD="$JAVA_HOME/bin/java"
  fi
else
  JAVACMD="java"
fi

if [ ! -x "$JAVACMD" ] ; then
  echo "Error: JAVA_HOME no está definido correctamente y el comando java no fue encontrado." >&2
  exit 1
fi

WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER="org.apache.maven.wrapper.MavenWrapperMain"
WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"

# Verificar si el JAR no existe o tiene tamaño 0
if [ ! -s "$WRAPPER_JAR" ]; then
    if [ -s "$HOME/.m2/wrapper/dists/apache-maven-3.9.9-bin/33b4b2b4/apache-maven-3.9.9/lib/maven-wrapper-3.3.2.jar" ]; then
        mkdir -p "$BASE_DIR/.mvn/wrapper"
        cp "$HOME/.m2/wrapper/dists/apache-maven-3.9.9-bin/33b4b2b4/apache-maven-3.9.9/lib/maven-wrapper-3.3.2.jar" "$WRAPPER_JAR"
    elif [ -s "$BASE_DIR/../lab12_agenda/.mvn/wrapper/maven-wrapper.jar" ]; then
        mkdir -p "$BASE_DIR/.mvn/wrapper"
        cp "$BASE_DIR/../lab12_agenda/.mvn/wrapper/maven-wrapper.jar" "$WRAPPER_JAR"
    elif [ -s "$BASE_DIR/../lab11_holamundo/.mvn/wrapper/maven-wrapper.jar" ]; then
        mkdir -p "$BASE_DIR/.mvn/wrapper"
        cp "$BASE_DIR/../lab11_holamundo/.mvn/wrapper/maven-wrapper.jar" "$WRAPPER_JAR"
    else
        rm -f "$WRAPPER_JAR"
        echo "Descargando Maven Wrapper jar desde $WRAPPER_URL..."
        mkdir -p "$BASE_DIR/.mvn/wrapper"
        if command -v curl >/dev/null 2>&1; then
            curl -s -f -L -o "$WRAPPER_JAR" "$WRAPPER_URL"
        elif command -v wget >/dev/null 2>&1; then
            wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL"
        else
            echo "Error: Ni curl ni wget fueron encontrados para descargar maven-wrapper.jar." >&2
            exit 1
        fi
    fi
fi

exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.home=$BASE_DIR/.mvn/wrapper/dists" \
  "-Dmaven.multiModuleProjectDirectory=$BASE_DIR" \
  $WRAPPER_LAUNCHER "$@"
